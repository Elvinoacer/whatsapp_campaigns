DATABASE_URL="postgresql://campaigns:campaigns@127.0.0.1:55432/campaigns?schema=public"
REDIS_URL="redis://127.0.0.1:56379"
PORT="3000"
AUTH_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="REPLACE_WITH_A_STRONG_PASSWORD"
SESSION_DIR=".wwebjs_auth"
DEFAULT_TIMEZONE="Africa/Nairobi"
MAX_CAMPAIGN_RECIPIENTS="25000"
SEND_INTERVAL_MS="3000"

# Internal workload controls, configurable live from Settings -> Sending Rules.
CAMPAIGN_MIN_INTERVAL_MS="15000"
CAMPAIGN_MAX_PER_15_MINUTES="10"
CAMPAIGN_MAX_PER_HOUR="35"
CAMPAIGN_MAX_PER_DAY="250"
CAMPAIGN_CONTACT_COOLDOWN_HOURS="0"
CAMPAIGN_START_HOUR="0"
CAMPAIGN_END_HOUR="24"
CAMPAIGN_TIMEZONE="Africa/Nairobi"
# Your actual business name; otherwise the sending account's label is used.
CAMPAIGN_BUSINESS_NAME=""
PUPPETEER_EXECUTABLE_PATH=""
