generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SessionStatus {
  DISCONNECTED
  CONNECTING
  QR_READY
  CONNECTED
  ERROR
}

enum ConsentStatus {
  UNKNOWN
  OPTED_IN
  OPTED_OUT
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum AudienceType {
  CONTACTS
  GROUPS
}

enum ScheduleType {
  NOW
  ONCE
  CRON
}

enum RunStatus {
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum DeliveryStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
  UNKNOWN
  SKIPPED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model WaSession {
  id        String        @id @default(cuid())
  label     String
  phone     String?
  status    SessionStatus @default(DISCONNECTED)
  error     String?
  lastSeen  DateTime?
  createdAt DateTime      @default(now())
  contacts  Contact[]
  groups    WaGroup[]
  campaigns Campaign[]
}

model Contact {
  id           String        @id @default(cuid())
  sessionId    String
  session      WaSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  whatsappId   String
  phone        String?
  name         String?
  isMyContact  Boolean       @default(false)
  consent      ConsentStatus @default(UNKNOWN)
  consentAt    DateTime?
  consentNote  String?
  lastSyncedAt DateTime      @default(now())
  createdAt    DateTime      @default(now())
  members      GroupMember[]
  segments     SegmentMember[]
  targets      CampaignContact[]
  @@unique([sessionId, whatsappId])
  @@index([sessionId, consent])
  @@index([whatsappId, consent])
}

model WaGroup {
  id               String    @id @default(cuid())
  sessionId        String
  session          WaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  whatsappId       String
  name             String
  participantCount Int       @default(0)
  allowPosting     Boolean   @default(false)
  lastSyncedAt     DateTime  @default(now())
  members          GroupMember[]
  targets          CampaignGroup[]
  @@unique([sessionId, whatsappId])
}

model GroupMember {
  groupId   String
  contactId String
  group     WaGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  @@id([groupId, contactId])
}

model Segment {
  id          String @id @default(cuid())
  name        String @unique
  description String?
  createdAt   DateTime @default(now())
  members     SegmentMember[]
  targets     CampaignSegment[]
}

model SegmentMember {
  segmentId String
  contactId String
  segment   Segment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  @@id([segmentId, contactId])
  @@index([contactId])
}

model Campaign {
  id           String         @id @default(cuid())
  name         String
  message      String         @db.Text
  mediaKey     String?
  mediaMime    String?
  mediaName    String?
  audienceType AudienceType
  sessionId    String
  session      WaSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  status       CampaignStatus @default(DRAFT)
  scheduleType ScheduleType   @default(NOW)
  scheduledAt  DateTime?
  cron         String?
  timezone     String         @default("Africa/Nairobi")
  sendIntervalMs Int          @default(5000)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  launchVersion Int            @default(0)
  runsCompleted Boolean      @default(false)
  contacts     CampaignContact[]
  groups       CampaignGroup[]
  segments     CampaignSegment[]
  runs         CampaignRun[]
  @@index([status, scheduledAt])
}

model CampaignContact {
  campaignId String
  contactId  String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  @@id([campaignId, contactId])
}

model CampaignGroup {
  campaignId String
  groupId    String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  group      WaGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  @@id([campaignId, groupId])
}

model CampaignSegment {
  campaignId String
  segmentId  String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  segment    Segment  @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  @@id([campaignId, segmentId])
}

model CampaignRun {
  id         String    @id @default(cuid())
  jobKey     String    @unique
  launchVersion Int    @default(0)
  sessionIdSnapshot String?
  messageSnapshot String? @db.Text
  mediaNameSnapshot String?
  audienceCount Int    @default(0)
  campaignId String
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  status     RunStatus @default(RUNNING)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  nextAttemptAt DateTime?
  error      String?
  deliveries Delivery[]
  @@index([campaignId, startedAt])
}

model Delivery {
  id           String         @id @default(cuid())
  runId        String
  run          CampaignRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  recipientKey String
  recipient    String
  status       DeliveryStatus @default(QUEUED)
  messageId    String?
  error        String?
  sentAt       DateTime?
  updatedAt    DateTime       @updatedAt
  replies      CampaignReply[]
  @@unique([runId, recipientKey])
  @@index([messageId])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  details   Json?
  createdAt DateTime @default(now())
}

model CampaignReply {
  id          String   @id @default(cuid())
  messageId   String   @unique
  deliveryId  String
  delivery    Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  body        String   @db.Text
  receivedAt  DateTime @default(now())
  attribution String
  author      String?
  isOptOut    Boolean  @default(false)
  @@index([deliveryId, receivedAt])
}

// Deliberately independent of campaign/session relations: deleting history or
// reconnecting an account must not erase volume limits or suppression history.
model SendAttempt {
  id            String         @id @default(cuid())
  deliveryId    String         @unique
  accountKey    String
  sessionId     String
  recipientKeys String[]
  attemptedAt   DateTime       @default(now())
  outcome       DeliveryStatus @default(SENDING)
  messageId     String?
  optedOutAt    DateTime?
  @@index([attemptedAt])
  @@index([accountKey, attemptedAt])
  @@index([recipientKeys], type: Gin)
  @@index([messageId])
}

model SendingHold {
  accountKey String    @id
  reason     String
  createdAt  DateTime  @default(now())
  notBefore  DateTime?
  releasedAt DateTime?
}
