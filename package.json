{
  "name": "whatsapp-campaigns",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "preworker": "patch-package --error-on-fail",
    "preworker:dev": "patch-package --error-on-fail",
    "setup": "node scripts/setup.mjs",
    "platform:dev": "node scripts/platform.mjs dev",
    "platform:production": "node scripts/platform.mjs production",
    "launcher:install": "node scripts/create-launcher.mjs",
    "services:up": "node scripts/services.mjs up",
    "services:down": "node scripts/services.mjs down",
    "doctor": "tsx scripts/doctor.ts",
    "dev": "node scripts/web.mjs dev",
    "dev:all": "npm run doctor && concurrently -k -n web,worker \"npm:dev\" \"npm:worker:dev\"",
    "worker": "tsx worker/index.ts",
    "worker:dev": "tsx watch worker/index.ts",
    "build": "prisma generate && next build",
    "start": "node scripts/web.mjs start",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx scripts/bootstrap.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "tsx scripts/integration.ts",
    "test:whatsapp": "patch-package --error-on-fail && tsx scripts/verify-whatsapp.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.63.0",
    "cron-parser": "^4.9.0",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.2",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "qrcode.react": "^4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "whatsapp-web.js": "1.34.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "patch-package": "^8.0.1",
    "prisma": "^6.19.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.0",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    },
    "tinypool": "^2.1.2"
  }
}
